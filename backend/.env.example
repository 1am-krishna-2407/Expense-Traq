# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database ─────────────────────────────────────────────
# Matches docker-compose.yml (host port 5433). Tune the pool with &connection_limit=10 if needed.
DATABASE_URL=postgresql://rupeeflow:rupeeflow@localhost:5433/rupeeflow?schema=public

# ── Auth ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_ACCESS_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=30
BCRYPT_COST=12

# ── Cookies / CORS ───────────────────────────────────────
# Exact frontend origin allowed by CORS (comma-separate multiple origins)
FRONTEND_ORIGIN=http://localhost:5173
# Leave empty for host-only cookies. Set e.g. ".example.com" in production if needed.
COOKIE_DOMAIN=
# strict (same-site deploys, default) | lax | none (cross-site deploys, e.g. Vercel + Render; forces Secure)
COOKIE_SAMESITE=strict

# ── Rate limiting (auth routes) ──────────────────────────
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=10

# ── Logging ──────────────────────────────────────────────
LOG_REQUESTS=true
